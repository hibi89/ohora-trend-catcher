# Copy this file to .env.local and fill values on this computer only.
# Never paste access tokens or API keys into chat, workflow JSON, or log output.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=
META_REQUEST_INTERVAL_SECONDS=25

# Helpy-V Reasoning is the Elice vision model selected for design tagging.
# Create its Dedicated endpoint in Elice AI Cloud, then enter its base URL and API key.
ELICE_API_BASE_URL=
ELICE_API_KEY=
ELICE_MODEL=helpy-v-reasoning-c