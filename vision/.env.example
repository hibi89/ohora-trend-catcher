# Copy to vision/.env.local; never commit this private file.
# Paste ONLY YOUR OWN currently valid credentials into local file.
# Base must be an OpenAI-compatible HTTPS v1 API URL.
VISION_BASE_URL=https://YOUR_PROVIDER_HOST/v1
VISION_MODEL=gemini-3.8-flash
VISION_API_KEY=

# Optional provider 2: only contacted by explicit `--provider fallback`.
# Do not silently transfer data between services.
VISION_FALLBACK_BASE_URL=
VISION_FALLBACK_MODEL=
VISION_FALLBACK_API_KEY=
